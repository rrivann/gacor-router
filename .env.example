# Gacor Router config. Copy to .env before starting the service, or export
# these as shell env vars — either works.

# Bind address. 127.0.0.1 is loopback-only (safe default: dashboard + curl on
# the same machine can reach it, nobody else can). Change to 0.0.0.0 to expose
# on your VPS's public IP.
#
# WARNING: before you flip HOST to 0.0.0.0, open the dashboard's API Keys page
# (via SSH tunnel: `ssh -L 7788:localhost:7788 user@vps`) and create at least
# one key. As long as HOST is loopback the /v1/* routes are open, but the
# moment they're reachable from the internet you want auth in place — the
# middleware only enforces keys when 1+ keys exist in the DB (open-gateway
# pattern; see project_api_keys memory).
HOST=127.0.0.1
PORT=7788

# SQLite file location. Default is ./gacor.db (project-relative). Point this
# somewhere persistent if your working directory isn't stable across restarts.
# DB_PATH=/var/lib/gacor-router/gacor.db
